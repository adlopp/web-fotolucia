---
// La web empieza siempre en /fotografias/: esta página solo redirige allí
import { SITE, url } from "../site";
const destino = url("/fotografias/");
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <title>{SITE.nombre} · {SITE.subtitulo}</title>
    <meta name="robots" content="noindex" />
    <link rel="canonical" href={destino} />
    <meta http-equiv="refresh" content={`0; url=${destino}`} />
    <script is:inline define:vars={{ destino }}>
      location.replace(destino);
    </script>
  </head>
  <body>
    <a href={destino}>Ir a Fotografías</a>
  </body>
</html>
