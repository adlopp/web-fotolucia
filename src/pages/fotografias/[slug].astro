---
import Base from "../../layouts/Base.astro";
import { categoriasOrdenadas } from "../../lib";
import { url } from "../../site";

export async function getStaticPaths() {
  const cats = await categoriasOrdenadas();
  return cats.map((c, i) => ({
    params: { slug: c.id },
    props: { categoria: c, siguiente: cats[(i + 1) % cats.length] },
  }));
}

const { categoria, siguiente } = Astro.props;
const { titulo, descripcion, fotos } = categoria.data;
---

<Base titulo={titulo} descripcion={descripcion ?? undefined}>
  <section class="intro">
    <a href={url("/")} class="etiqueta volver">← Fotografías</a>
    <h1>{titulo}</h1>
    {descripcion && <p>{descripcion}</p>}
  </section>

  {fotos.length === 0 && <p class="vacio">Todavía no hay fotos en esta categoría.</p>}

  <div class="galeria">
    {
      fotos.map((f, i) => (
        <figure>
          <button type="button" class="abrir" data-indice={i} aria-label={`Ampliar ${f.titulo ?? "foto"}`}>
            <img src={url(f.imagen)} alt={f.titulo ?? ""} loading={i < 4 ? "eager" : "lazy"} />
          </button>
          {(f.titulo || f.pie) && (
            <figcaption>
              {f.titulo && <span class="titulo">{f.titulo}</span>}
              {f.pie && <span class="texto-pie">{f.pie}</span>}
            </figcaption>
          )}
        </figure>
      ))
    }
  </div>

  {
    siguiente.id !== categoria.id && (
      <div class="seccion-titulo">
        <span class="etiqueta">Siguiente colección</span>
        <a href={url(`/fotografias/${siguiente.id}`)} class="enlace-flecha">
          {siguiente.data.titulo} →
        </a>
      </div>
    )
  }

  <!-- Visor a pantalla completa -->
  <dialog class="visor" aria-label="Visor de fotos">
    <button type="button" class="cerrar" aria-label="Cerrar">✕</button>
    <button type="button" class="nav anterior" aria-label="Anterior">‹</button>
    <figure>
      <img src="" alt="" />
      <figcaption></figcaption>
    </figure>
    <button type="button" class="nav siguiente" aria-label="Siguiente">›</button>
  </dialog>

  <script type="application/json" id="datos-fotos" set:html={JSON.stringify(fotos.map((f) => ({ ...f, imagen: url(f.imagen) })))} />
</Base>

<style>
  .volver {
    text-decoration: none;
    display: inline-block;
    margin-bottom: 16px;
  }

  .volver:hover {
    color: var(--texto);
  }

  .vacio {
    color: var(--suave);
  }

  /* Cuadrícula: todas las fotos del mismo tamaño (cuadradas); en el visor se ven enteras */
  .galeria {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
    gap: 24px;
  }

  .galeria figure {
    margin: 0;
  }

  .abrir {
    display: block;
    width: 100%;
    aspect-ratio: 1;
    overflow: hidden;
    padding: 0;
    border: 0;
    background: var(--linea);
    cursor: zoom-in;
  }

  .abrir img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: opacity 0.3s;
  }

  .abrir:hover img {
    opacity: 0.88;
  }

  figcaption {
    display: flex;
    flex-direction: column;
    margin-top: 8px;
    font-size: 0.85rem;
  }

  .titulo {
    font-family: var(--serif);
    font-size: 1.15rem;
  }

  .texto-pie {
    color: var(--suave);
  }

  /* Visor */
  .visor {
    width: 100vw;
    height: 100vh;
    max-width: none;
    max-height: none;
    margin: 0;
    padding: 0;
    border: 0;
    background: rgba(20, 19, 17, 0.97);
    color: #f3efe9;
  }

  .visor[open] {
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .visor figure {
    margin: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 12px;
    padding: 56px 16px 24px;
  }

  .visor img {
    max-width: min(88vw, 1600px);
    max-height: calc(100vh - 140px);
    object-fit: contain;
  }

  .visor figcaption {
    text-align: center;
    color: #cfc8bf;
    margin: 0;
  }

  .visor button {
    background: none;
    border: 0;
    color: inherit;
    cursor: pointer;
    font-family: var(--sans);
  }

  .cerrar {
    position: absolute;
    top: 18px;
    right: 22px;
    font-size: 1.4rem;
  }

  .nav {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    font-size: 3rem;
    padding: 24px 16px;
    opacity: 0.7;
  }

  .nav:hover,
  .cerrar:hover {
    opacity: 1;
  }

  .anterior {
    left: 4px;
  }

  .siguiente {
    right: 4px;
  }
</style>

<script>
  type Foto = { imagen: string; titulo?: string | null; pie?: string | null };
  const fotos: Foto[] = JSON.parse(document.getElementById("datos-fotos")?.textContent || "[]");
  const visor = document.querySelector<HTMLDialogElement>(".visor")!;
  const img = visor.querySelector("img")!;
  const pie = visor.querySelector("figcaption")!;
  let actual = 0;

  function mostrar(i: number) {
    actual = (i + fotos.length) % fotos.length;
    const f = fotos[actual];
    img.src = f.imagen;
    img.alt = f.titulo ?? "";
    pie.textContent = [f.titulo, f.pie].filter(Boolean).join(" — ");
  }

  document.querySelectorAll<HTMLButtonElement>(".abrir").forEach((b) =>
    b.addEventListener("click", () => {
      mostrar(Number(b.dataset.indice));
      visor.showModal();
    })
  );

  visor.querySelector(".cerrar")!.addEventListener("click", () => visor.close());
  visor.querySelector(".anterior")!.addEventListener("click", () => mostrar(actual - 1));
  visor.querySelector(".siguiente")!.addEventListener("click", () => mostrar(actual + 1));
  // Clic fuera de la foto para cerrar
  visor.addEventListener("click", (e) => {
    if (e.target === visor || e.target === visor.querySelector("figure")) visor.close();
  });
  document.addEventListener("keydown", (e) => {
    if (!visor.open) return;
    if (e.key === "ArrowLeft") mostrar(actual - 1);
    if (e.key === "ArrowRight") mostrar(actual + 1);
  });
  // Deslizar en el móvil
  let inicioX = 0;
  visor.addEventListener("touchstart", (e) => (inicioX = e.touches[0].clientX), { passive: true });
  visor.addEventListener("touchend", (e) => {
    const dx = e.changedTouches[0].clientX - inicioX;
    if (Math.abs(dx) > 50) mostrar(actual + (dx < 0 ? 1 : -1));
  });
</script>
