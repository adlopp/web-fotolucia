---
// «Fotografías» es la portada de la web: esta dirección solo redirige allí (por si alguien tiene el enlace guardado)
import { SITE, url } from "../../site";
const destino = url("/");
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <title>{SITE.nombre} · {SITE.subtitulo}</title>
    <meta name="robots" content="noindex" />
    <link rel="canonical" href={destino} />
    <meta http-equiv="refresh" content={`0; url=${destino}`} />
    <script is:inline define:vars={{ destino }}>
      location.replace(destino);
    </script>
  </head>
  <body>
    <a href={destino}>Ir a Fotografías</a>
  </body>
</html>
