---
import { categoriasOrdenadas, portadaDe } from "../lib";
import { url } from "../site";
const categorias = await categoriasOrdenadas();
---

<div class="categorias">
  {
    categorias.map((c, i) => (
      <a href={url(`/fotografias/${c.id}`)} class="categoria">
        <div class="marco">
          {portadaDe(c) && (
            <img src={url(portadaDe(c)!)} alt={c.data.titulo} loading={i < 2 ? "eager" : "lazy"} />
          )}
        </div>
        <div class="texto">
          <h2 data-en={c.data.tituloEn || c.data.titulo}>{c.data.titulo}</h2>
          <span class="etiqueta" data-en={`${c.data.fotos.length} ${c.data.fotos.length === 1 ? "photo" : "photos"}`}>{c.data.fotos.length} fotos</span>
        </div>
      </a>
    ))
  }
</div>

<style>
  .categorias {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 48px 32px;
  }

  @media (max-width: 700px) {
    .categorias {
      grid-template-columns: 1fr;
      gap: 40px;
    }
  }

  .categoria {
    text-decoration: none;
  }

  .marco {
    aspect-ratio: 4 / 5;
    overflow: hidden;
    background: var(--linea);
  }

  .marco img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.8s ease, filter 0.5s ease;
  }

  .categoria:hover img {
    transform: scale(1.03);
    filter: brightness(0.92);
  }

  .texto {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 12px;
    margin-top: 16px;
  }

  .texto h2 {
    font-size: 1.7rem;
  }
</style>
