---
import type { CollectionEntry } from "astro:content";
import { formatoFecha, formatoFechaEn, url } from "../site";

interface Props {
  entrada: CollectionEntry<"blog">;
}
const { entrada } = Astro.props;
const { titulo, fecha, portada, resumen } = entrada.data;
---

<a href={url(`/blog/${entrada.id}`)} class="tarjeta">
  <div class="marco">
    {portada && <img src={url(portada)} alt="" loading="lazy" />}
  </div>
  <time class="etiqueta" datetime={fecha.toISOString()} data-en={formatoFechaEn(fecha)}>{formatoFecha(fecha)}</time>
  <h3>{titulo}</h3>
  {resumen && <p>{resumen}</p>}
</a>

<style>
  .tarjeta {
    text-decoration: none;
    display: block;
  }

  .marco {
    aspect-ratio: 3 / 2;
    overflow: hidden;
    background: var(--linea);
    margin-bottom: 16px;
  }

  .marco img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.8s ease;
  }

  .tarjeta:hover img {
    transform: scale(1.03);
  }

  h3 {
    font-size: 1.55rem;
    margin: 6px 0 8px;
  }

  .tarjeta:hover h3 {
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 5px;
  }

  p {
    margin: 0;
    color: var(--suave);
    font-size: 0.95rem;
  }
</style>
