  <path d="M0 0 30 20M30 0 0 20" stroke="#cf142b" stroke-width="1.6"></path>
  <path d="M15 0V20M0 10H30" stroke="#fff" stroke-width="7"></path>
  <path d="M15 0V20M0 10H30" stroke="#cf142b" stroke-width="3"></path>
